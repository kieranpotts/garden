#!/usr/bin/env bash

#
# Walk every garden page and run the `split` skill on it individually, scoped and
# non-interactive (see .agents/skills/split/SKILL.md), opening one PR per page that
# genuinely warranted splitting. Most pages won't qualify and are skipped with no branch or
# PR. A confirmed split touches the original page plus one or more newly created pages and
# index.adoc, so the whole working tree is staged rather than a fixed path list.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

PAGES_DIR="src/modules/ROOT/pages"
INDEX="$PAGES_DIR/index.adoc"

garden::check_clean
garden::sync_base

shopt -s nullglob
for file in "$PAGES_DIR"/*.adoc; do
  [[ "$file" == "$INDEX" ]] && continue
  name="$(basename "$file")"
  echo "=== Considering split: $file ==="
  garden::open_branch "split-${name%.adoc}" >/dev/null

  pi -p --no-session \
    --model "$MODEL" \
    --thinking low \
    --tools read,edit,grep,find,ls \
    "Follow the split skill's instructions in .agents/skills/split/SKILL.md for exactly one
page: '$file'.
This is a non-interactive run: never ask for confirmation. Only proceed with a split if
'$file' unambiguously covers two or more concepts that could each stand alone; otherwise make
no changes. If it does qualify, create the new page(s), narrow '$file', cross-link them, and
add the new pages to $INDEX. Do not edit any other existing page. Do not run bash and do not
commit."

  garden::commit_push_pr \
    "split: divide ${name%.adoc}" \
    "Split: ${name%.adoc}" \
    "Automated split pass over \`$file\`, generated by pi. Review before merging." \
    || continue
done
