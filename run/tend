#!/usr/bin/env bash

#
# Walk every garden page and run the `tend` skill on it individually, scoped and
# non-interactive (see .agents/skills/tend/SKILL.md), opening one PR per page that needed
# a fix. Pages with nothing to fix are skipped with no branch or PR.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

PAGES_DIR="src/modules/ROOT/pages"
INDEX="$PAGES_DIR/index.adoc"

garden::check_clean
garden::sync_base

shopt -s nullglob
for file in "$PAGES_DIR"/*.adoc; do
  [[ "$file" == "$INDEX" ]] && continue
  name="$(basename "$file")"
  echo "=== Tending: $file ==="
  garden::open_branch "tend-${name%.adoc}" >/dev/null

  pi -p --no-session \
    --model "$MODEL" \
    --thinking low \
    --tools read,edit,grep,find,ls \
    "Follow the tend skill's instructions in .agents/skills/tend/SKILL.md for exactly one
page: '$file'.
This is a non-interactive run: never ask for confirmation. Apply only unambiguous fixes to
'$file' (and, only if it is itself an orphan, one xref line added to $INDEX). Leave everything
else unchanged and report it instead of guessing. Do not run bash and do not commit."

  garden::commit_push_pr \
    "tend: fix links in ${name%.adoc}" \
    "Tend: ${name%.adoc}" \
    "Automated tend pass over \`$file\`, generated by pi. Review before merging." \
    "$file" "$INDEX" \
    || continue
done
