#!/usr/bin/env bash

#
# Walk every garden page and run the `divide` skill on it individually, scoped and
# non-interactive (see .agents/skills/divide/SKILL.md), opening one PR per page that
# genuinely warranted dividing. Most pages won't qualify and are skipped with no branch or
# PR. A confirmed divide touches the original page plus one or more newly created pages and
# both index.adoc and nav.adoc, so the whole working tree is staged rather than a fixed path
# list.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

PAGES_DIR="src/modules/ROOT/pages"
INDEX="$PAGES_DIR/index.adoc"
NAV="$PAGES_DIR/nav.adoc"

garden::check_clean
garden::sync_base

shopt -s nullglob
for file in "$PAGES_DIR"/*.adoc; do
  [[ "$file" == "$INDEX" ]] && continue
  name="$(basename "$file")"
  echo "=== Considering divide: $file ==="
  garden::open_branch "divide-${name%.adoc}" >/dev/null

  pi -p --no-session \
    --model "$MODEL" \
    --thinking low \
    --tools read,edit,grep,find,ls \
    "Follow the divide skill's instructions in .agents/skills/divide/SKILL.md for exactly one
page: '$file'.
This is a non-interactive run: never ask for confirmation. Only proceed with a divide if
'$file' unambiguously covers two or more concepts that could each stand alone and would be
cross-referenced from more than one other entry; otherwise make no changes. If it does
qualify, create the new page(s), narrow '$file', cross-link them, and add the new pages to
$INDEX (marked Seedling) and to $NAV at the matching alphabetical position. Do not edit any
other existing page. Do not run bash and do not commit."

  garden::commit_push_pr \
    "divide: split ${name%.adoc}" \
    "Divide: ${name%.adoc}" \
    "Automated divide pass over \`$file\`, generated by pi. Review before merging." \
    || continue
done