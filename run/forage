#!/usr/bin/env bash

#
# Walk every garden page and run the `forage` skill on it individually, scoped and
# non-interactive (see .agents/skills/forage/SKILL.md), accumulating each page's candidate
# topics into TODO.md at the repo root and opening one PR for the refreshed report. Pages
# with no candidates contribute nothing. Foraging is read-only on the garden — only TODO.md
# is written. No-ops cleanly if no candidates were found across the whole pass.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

PAGES_DIR="src/modules/ROOT/pages"
INDEX="$PAGES_DIR/index.adoc"
TODO="TODO.md"

garden::check_clean
garden::sync_base

branch="$(garden::open_branch "forage")"

# Seed TODO.md with a header, and remember it so we can detect a no-op.
{
  echo "= Forage candidates"
  echo
  echo "Topics referenced or implied in garden entries that have no entry of their own,"
  echo "ranked per entry. Regenerated by an automated forage pass."
  echo
} > "$TODO"
header="$(mktemp)"
cp "$TODO" "$header"

shopt -s nullglob
for file in "$PAGES_DIR"/*.adoc; do
  [[ "$file" == "$INDEX" ]] && continue
  name="$(basename "$file")"
  echo "=== Foraging: $file ==="

  pi -p --no-session \
    --model "$MODEL" \
    --thinking low \
    --tools read,edit,grep,find,ls \
    "Follow the forage skill's instructions in .agents/skills/forage/SKILL.md for exactly one
page: '$file'.
This is a non-interactive run: never ask for confirmation. Find topics referenced or implied in
'$file' that have no entry of their own under $PAGES_DIR, rank them by how central they are to
the entry's subject, and append your findings to $TODO at the repo root under an AsciiDoc '== $name'
heading beneath the existing '=' title. If '$file' has no candidates, append nothing and make no
other change. Do not edit any page under $PAGES_DIR, do not remove or alter existing content in
$TODO, do not run bash, and do not commit."
done

if diff -q "$TODO" "$header" >/dev/null; then
  echo "=== No forage candidates; skipping PR ==="
  rm -f "$header"
  git checkout "$BASE_BRANCH" >&2
  git branch -D "$branch" >&2
  exit 0
fi
rm -f "$header"

garden::commit_push_pr \
  "chore: refresh forage findings" \
  "Forage: refresh TODO.md" \
  "Automated forage pass, generated by pi, refreshing TODO.md with per-entry candidate topics. Review before merging." \
  "$TODO"