#!/usr/bin/env bash

#
# Walk every garden page and run the `forage` skill on it individually, scoped and
# non-interactive (see .agents/skills/forage/SKILL.md), accumulating each page's candidate
# topics into a temporary Markdown report and opening one GitHub issue suggesting entries
# worth sowing. Pages with no candidates contribute nothing. Foraging is read-only on the
# garden — no file in the repo is committed or pushed; the report lives only long enough to
# become the issue body, then is deleted. No-ops cleanly (no issue) if no candidates found.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

PAGES_DIR="src/modules/ROOT/pages"
INDEX="$PAGES_DIR/index.adoc"
REPORT="$REPO_ROOT/.forage-report.md"
header=""

cleanup() {
  rm -f "$REPORT" "$header"
}
trap cleanup EXIT

garden::check_clean
garden::sync_base

# Seed the report with a header, and remember it so we can detect a no-op.
{
  echo "# Forage candidates"
  echo
  echo "Topics referenced or implied in garden entries that have no entry of their own,"
  echo "ranked per entry. Suggested entries to sow, generated by an automated forage pass."
  echo
} > "$REPORT"
header="$(mktemp -t forage-header.XXXXXX)"
cp "$REPORT" "$header"

shopt -s nullglob
for file in "$PAGES_DIR"/*.adoc; do
  [[ "$file" == "$INDEX" ]] && continue
  name="$(basename "$file")"
  echo "=== Foraging: $file ==="

  pi -p --no-session \
    --model "$MODEL" \
    --thinking low \
    --tools read,edit,grep,find,ls \
    "Follow the forage skill's instructions in .agents/skills/forage/SKILL.md for exactly one
page: '$file'.
This is a non-interactive run: never ask for confirmation. Find topics referenced or implied in
'$file' that have no entry of their own under $PAGES_DIR, rank them by how central they are to
the entry's subject, and append your findings to $REPORT under a Markdown '## $name' heading
beneath the existing '#' title. For each candidate, give a one-line reason and name the passage
in '$file' that surfaced it. If '$file' has no candidates, append nothing and make no other
change. Do not edit any page under $PAGES_DIR, do not remove or alter existing content in
$REPORT, do not run bash, and do not commit."
done

if diff -q "$REPORT" "$header" >/dev/null; then
  echo "=== No forage candidates; no issue opened ==="
  exit 0
fi

garden::open_issue \
  "Forage: candidate entries to sow" \
  "$REPORT"
echo "=== Opened forage issue ==="