#!/usr/bin/env bash

#
# Run the `forage` skill headlessly as a single whole-garden pass, scoped and non-interactive
# (see .agents/skills/forage/SKILL.md), regenerating TODO.md and opening one PR for it.
# No-ops cleanly if TODO.md comes out unchanged.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

garden::check_clean
garden::sync_base

echo "=== Foraging the garden ==="
garden::open_branch "forage" >/dev/null

pi -p --no-session \
  --model "$MODEL" \
  --thinking low \
  --tools read,edit,grep,find,ls \
  "Follow the forage skill's instructions in .agents/skills/forage/SKILL.md as a single
whole-garden pass.
This is a non-interactive run: never ask for confirmation. Collect candidate topics, rank
them by mention frequency, and write the full ranked list to TODO.md at the repo root,
replacing its previous contents. Do not edit any page under src/modules/ROOT/pages/. Do not
run bash and do not commit."

garden::commit_push_pr \
  "chore: update forage findings" \
  "Forage: garden-wide scan" \
  "Automated forage pass over the whole garden, generated by pi, refreshing TODO.md. Review before merging." \
  "TODO.md"
