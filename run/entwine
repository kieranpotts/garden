#!/usr/bin/env bash

#
# Walk every garden page and run the `entwine` skill on it individually, scoped and
# non-interactive (see .agents/skills/entwine/SKILL.md), opening one PR per page that
# gained a link. Pages already densely linked are skipped with no branch or PR. A confirmed
# entwine touches the target page plus any neighbours it links back to, so the whole working
# tree is staged rather than a fixed path list.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

PAGES_DIR="src/modules/ROOT/pages"
INDEX="$PAGES_DIR/index.adoc"

garden::check_clean
garden::sync_base

shopt -s nullglob
for file in "$PAGES_DIR"/*.adoc; do
  [[ "$file" == "$INDEX" ]] && continue
  name="$(basename "$file")"
  echo "=== Entwining: $file ==="
  garden::open_branch "entwine-${name%.adoc}" >/dev/null

  pi -p --no-session \
    --model "$MODEL" \
    --thinking low \
    --tools read,edit,grep,find,ls \
    "Follow the entwine skill's instructions in .agents/skills/entwine/SKILL.md for exactly one
page: '$file'.
This is a non-interactive run: never ask for confirmation. Find entries related to '$file' but
not yet cross-referenced from it, and add the missing xref: links — in both directions where the
relationship reads naturally in each entry's context, in one direction otherwise. Only add a link
where the connection is obvious and easy to justify in one line; favor precision over volume. Do
not create pages, repair broken xref:s, or rewrite content beyond inserting a link and, where
natural, a short introducing clause. If '$file' is already densely linked, make no changes. Do
not run bash and do not commit."

  garden::commit_push_pr \
    "entwine: link ${name%.adoc}" \
    "Entwine: ${name%.adoc}" \
    "Automated entwine pass over \`$file\`, generated by pi. Review before merging." \
    || continue
done