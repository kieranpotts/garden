#!/usr/bin/env bash

#
# Run the `entwine` skill headlessly as a single whole-garden pass, scoped and non-interactive
# (see .agents/skills/entwine/SKILL.md), opening one PR covering every unambiguous
# cross-reference added in this pass. No-ops cleanly if nothing was linked.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

garden::check_clean
garden::sync_base

echo "=== Entwining the garden ==="
garden::open_branch "entwine" >/dev/null

pi -p --no-session \
  --model "$MODEL" \
  --thinking low \
  --tools read,edit,grep,find,ls \
  "Follow the entwine skill's instructions in .agents/skills/entwine/SKILL.md as a single
whole-garden pass.
This is a non-interactive run: never ask for confirmation. Only add xref: links for pairs
whose relationship is obvious and easy to justify in one line. Don't create pages or rewrite
content beyond inserting a link and, where natural, a short introducing clause. Report every
pair considered, including any left unlinked. Do not run bash and do not commit."

garden::commit_push_pr \
  "entwine: link related entries" \
  "Entwine: garden-wide pass" \
  "Automated entwine pass over the whole garden, generated by pi. Review before merging."
