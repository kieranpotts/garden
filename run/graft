#!/usr/bin/env bash

#
# Run the `graft` skill headlessly for one target entry and one dead-head entry given on the
# command line, scoped and non-interactive (see .agents/skills/graft/SKILL.md), opening one PR
# that absorbs the dead-head into the target. The `pi` CLI cannot delete files, so once the
# agent has merged the content and repointed every reference, the wrapper removes the dead-head
# file itself before committing. No-ops cleanly if the dead-head is not a graft candidate.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

PAGES_DIR="src/modules/ROOT/pages"
INDEX="$PAGES_DIR/index.adoc"
NAV="$PAGES_DIR/nav.adoc"

# Normalize a user argument (with or without .adoc, bare slug, or full path) to a pages path.
normalize() {
  local arg="$1"
  arg="${arg%.adoc}"
  arg="${arg##*/}"
  printf '%s/%s.adoc' "$PAGES_DIR" "$arg"
}

TARGET_RAW="${1:-}"
DEADHEAD_RAW="${2:-}"
if [[ -z "$TARGET_RAW" || -z "$DEADHEAD_RAW" ]]; then
  echo "Usage: run/graft <target-entry> <dead-head-entry>" >&2
  echo "  Absorbs the dead-head entry into the target entry. Each may be a bare slug," >&2
  echo "  a filename, or a path under $PAGES_DIR/." >&2
  exit 1
fi

TARGET="$(normalize "$TARGET_RAW")"
DEADHEAD="$(normalize "$DEADHEAD_RAW")"

if [[ ! -f "$TARGET" ]]; then
  echo "Target entry not found: $TARGET" >&2
  exit 1
fi
if [[ ! -f "$DEADHEAD" ]]; then
  echo "Dead-head entry not found: $DEADHEAD" >&2
  exit 1
fi
if [[ "$TARGET" == "$DEADHEAD" ]]; then
  echo "Target and dead-head must be different entries." >&2
  exit 1
fi

target_name="$(basename "$TARGET")"
deadhead_name="$(basename "$DEADHEAD")"

garden::check_clean
garden::sync_base

echo "=== Grafting: $deadhead_name into $target_name ==="
branch="$(garden::open_branch "graft-${deadhead_name%.adoc}-into-${target_name%.adoc}")"

pi -p --no-session \
  --model "$MODEL" \
  --thinking low \
  --tools read,edit,grep,find,ls \
  "Follow the graft skill's instructions in .agents/skills/graft/SKILL.md to graft the dead-head
entry '$DEADHEAD' into the target entry '$TARGET'.
This is a non-interactive run: never ask for confirmation. Carry the dead-head's distinct content
into the target as coherent sections, rewriting transitions so the target reads as one entry. Then
repoint every xref: anywhere under $PAGES_DIR that names '$DEADHEAD' to '$TARGET', adjusting link
text so it still reads in context and collapsing any duplicate link to the target that results.
Remove the dead-head's listing from $INDEX and $NAV; update the target's listing only if its title
must change, which it should not unless the merged content clearly demands a broader name. Do not
delete '$DEADHEAD' yourself — the wrapper script does that once you have finished. If the dead-head
adds nothing the target lacks (a drop, not a graft), or the merge would leave the target covering
more than one concept, make no changes at all and report why. Do not run bash and do not commit."

if git diff --quiet && git diff --cached --quiet; then
  echo "=== Nothing to graft: $deadhead_name into $target_name ==="
  git checkout "$BASE_BRANCH" >&2
  git branch -D "$branch" >&2
  exit 0
fi

git rm "$DEADHEAD"

garden::commit_push_pr \
  "graft: merge ${deadhead_name%.adoc} into ${target_name%.adoc}" \
  "Graft: ${deadhead_name%.adoc} -> ${target_name%.adoc}" \
  "Automated graft absorbing \`$DEADHEAD\` into \`$TARGET\`, generated by pi. Review before merging."