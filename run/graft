#!/usr/bin/env bash

#
# Run the `graft` skill headlessly as a single whole-garden pass, scoped and non-interactive
# (see .agents/skills/graft/SKILL.md), opening one PR covering every unambiguous merge found
# in this pass. No-ops cleanly if nothing was grafted.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

garden::check_clean
garden::sync_base

echo "=== Grafting the garden ==="
garden::open_branch "graft" >/dev/null

pi -p --no-session \
  --model "$MODEL" \
  --thinking low \
  --tools read,edit,grep,find,ls \
  "Follow the graft skill's instructions in .agents/skills/graft/SKILL.md as a single
whole-garden pass.
This is a non-interactive run: never ask for confirmation. Find candidate groups of related-
but-distinct thin pages yourself; only merge a group when the survivor, title, and section
mapping are all unambiguous. Repoint every xref: and index.adoc entry before deleting any
absorbed page. Report every candidate group considered, including any left unmerged. Do not
run bash and do not commit."

garden::commit_push_pr \
  "graft: merge related entries" \
  "Graft: garden-wide pass" \
  "Automated graft pass over the whole garden, generated by pi. Review before merging."
