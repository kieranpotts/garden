#!/usr/bin/env bash

#
# Run the `sow` skill headlessly for a single topic given on the command line, scoped and
# non-interactive (see .agents/skills/sow/SKILL.md), opening one PR for the new entry. Unlike
# the per-page scripts, sow doesn't iterate existing pages — it plants exactly one new one.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

TOPIC="${1:-}"
if [[ -z "$TOPIC" ]]; then
  echo "Usage: run/sow <topic>" >&2
  exit 1
fi

PAGES_DIR="src/modules/ROOT/pages"
INDEX="$PAGES_DIR/index.adoc"
SLUG="$(echo "$TOPIC" | tr '[:upper:] ' '[:lower:]-' | tr -cs 'a-z0-9-' '-' | sed 's/^-*//; s/-*$//')"

garden::check_clean
garden::sync_base

echo "=== Sowing: $TOPIC ==="
garden::open_branch "sow-${SLUG}" >/dev/null

pi -p --no-session \
  --model "$MODEL" \
  --thinking low \
  --tools read,edit,grep,find,ls \
  "Follow the sow skill's instructions in .agents/skills/sow/SKILL.md to plant a new entry
for the topic: '$TOPIC'.
This is a non-interactive run: never ask for confirmation. If an existing page already covers
this topic, make no changes at all and say so. Otherwise research the topic, write the new
page under $PAGES_DIR, link it both directions where natural, and add it to $INDEX marked
Seedling. Do not run bash and do not commit."

garden::commit_push_pr \
  "sow: add entry for ${TOPIC,,}" \
  "Sow: ${TOPIC}" \
  "Automated sow pass for the topic '${TOPIC}', generated by pi. Review before merging."
