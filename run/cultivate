#!/usr/bin/env bash

#
# Walk every garden page and run the `cultivate` skill on it individually, scoped and
# non-interactive (see .agents/skills/cultivate/SKILL.md), accumulating a triage table into
# TODO.md at the repo root and opening one PR for it. Each row names an entry that needs
# extra work and the skill(s) recommended to improve it. Entries in good shape contribute no
# row. Cultivating is read-only on the garden — only TODO.md is written. No-ops cleanly if
# every entry is in good shape.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

PAGES_DIR="src/modules/ROOT/pages"
INDEX="$PAGES_DIR/index.adoc"
TODO="TODO.md"

garden::check_clean
garden::sync_base

branch="$(garden::open_branch "cultivate")"

# Seed TODO.md with the table header, and remember it so we can detect a no-op.
{
  echo "# Cultivate triage"
  echo
  echo "Garden entries that need extra work, with the recommended skill(s) to run on them."
  echo "Generated by an automated cultivate pass."
  echo
  echo "| Entry | Needs | Why |"
  echo "| --- | --- | --- |"
} > "$TODO"
header="$(mktemp -t cultivate-header.XXXXXX)"
cp "$TODO" "$header"
trap 'rm -f "$header"' EXIT

shopt -s nullglob
for file in "$PAGES_DIR"/*.adoc; do
  [[ "$file" == "$INDEX" ]] && continue
  name="$(basename "$file")"
  slug="${name%.adoc}"
  echo "=== Cultivating: $file ==="

  pi -p --no-session \
    --model "$MODEL" \
    --thinking low \
    --tools read,edit,grep,find,ls \
    "Follow the cultivate skill's instructions in .agents/skills/cultivate/SKILL.md for exactly
one page: '$file'.
This is a non-interactive run: never ask for confirmation. Triage '$file' against every
improvement skill's criterion (water, fertilize, divide, entwine, tend, tidy, prune, graft,
uproot). If one or more recommendations apply, append exactly one Markdown table row to $TODO
beneath the existing header, in the form:
| $slug | <comma-separated skill names> | <one-line reason citing the main evidence> |
Do not append a row if '$file' is in good shape. Do not edit the header or any existing row in
$TODO, do not edit any page under $PAGES_DIR, do not run bash, and do not commit."
done

if diff -q "$TODO" "$header" >/dev/null; then
  echo "=== Every entry in good shape; no PR opened ==="
  git checkout "$BASE_BRANCH" >&2
  git branch -D "$branch" >&2
  exit 0
fi

garden::commit_push_pr \
  "chore: refresh cultivate triage" \
  "Cultivate: refresh TODO.md triage" \
  "Automated cultivate pass, generated by pi, refreshing TODO.md with a per-entry triage table. Review before merging." \
  "$TODO"