#!/usr/bin/env bash

#
# Walk every garden page and run the `cultivate` skill on it individually, scoped and
# non-interactive (see .agents/skills/cultivate/SKILL.md), opening one PR per page that
# needed a style fix. Pages with nothing to fix are skipped with no branch or PR.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

PAGES_DIR="src/modules/ROOT/pages"
INDEX="$PAGES_DIR/index.adoc"

garden::check_clean
garden::sync_base

shopt -s nullglob
for file in "$PAGES_DIR"/*.adoc; do
  [[ "$file" == "$INDEX" ]] && continue
  name="$(basename "$file")"
  echo "=== Cultivating: $file ==="
  garden::open_branch "cultivate-${name%.adoc}" >/dev/null

  pi -p --no-session \
    --model "$MODEL" \
    --thinking low \
    --tools read,edit,grep,find,ls \
    "Follow the cultivate skill's instructions in .agents/skills/cultivate/SKILL.md for
exactly one page: '$file'. Read docs/style-guide.md in full first.
This is a non-interactive run: never ask for confirmation. Apply only unambiguous mechanical
style fixes to '$file'. Leave sentence-level rewrites, bolding judgment calls, and any
structural issue unchanged and report them instead of guessing. Do not edit any other page.
Do not run bash and do not commit."

  garden::commit_push_pr \
    "cultivate: fix style in ${name%.adoc}" \
    "Cultivate: ${name%.adoc}" \
    "Automated cultivate pass over \`$file\`, generated by pi. Review before merging." \
    "$file"
done
