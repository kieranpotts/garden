#!/usr/bin/env bash

#
# Walk every garden page and run the `uproot` skill on it individually, scoped and
# non-interactive (see .agents/skills/uproot/SKILL.md), opening one PR per page that was
# genuinely redundant and dropped. Pages that are not redundant are skipped with no branch
# or PR. Uproot is single-target per the skill (one drop per run), which the per-page loop
# honours: each confirmed drop gets its own branch and PR. The `pi` CLI cannot delete files,
# so once the agent has repointed every reference and confirmed redundancy, the wrapper
# removes the target file itself before committing.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

PAGES_DIR="src/modules/ROOT/pages"
INDEX="$PAGES_DIR/index.adoc"
NAV="$PAGES_DIR/nav.adoc"

garden::check_clean
garden::sync_base

shopt -s nullglob
for file in "$PAGES_DIR"/*.adoc; do
  [[ "$file" == "$INDEX" ]] && continue
  name="$(basename "$file")"
  echo "=== Considering uproot: $file ==="
  branch="$(garden::open_branch "uproot-${name%.adoc}")"

  pi -p --no-session \
    --model "$MODEL" \
    --thinking low \
    --tools read,edit,grep,find,ls \
    "Follow the uproot skill's instructions in .agents/skills/uproot/SKILL.md for the target
entry '$file'.
This is a non-interactive run: never ask for confirmation. Proceed only if '$file' is
genuinely redundant — its topic already fully covered by another entry, with nothing unique
lost. If so, salvage any stray scrap into the covering entry, repoint every xref: that
names '$file' to the covering entry (editing whichever pages hold those links), and remove
'$file''s listing from $INDEX and $NAV. If '$file' is not redundant, or you are in doubt,
make no changes at all and report why. Do not delete '$file' yourself — the wrapper script
does that once you have confirmed redundancy. Do not run bash and do not commit."

  if git diff --quiet && git diff --cached --quiet; then
    echo "=== Not redundant: $file ==="
    git checkout "$BASE_BRANCH" >&2
    git branch -D "$branch" >&2
    continue
  fi

  git rm "$file"
  garden::commit_push_pr \
    "uproot: drop ${name%.adoc}" \
    "Uproot: ${name%.adoc}" \
    "Automated uproot pass dropping \`$file\` as redundant, generated by pi. Review before merging." \
    || continue
done