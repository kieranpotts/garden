#!/usr/bin/env bash

#
# Walk every garden page and run the `fertilize` skill on it individually, scoped and
# non-interactive (see .agents/skills/fertilize/SKILL.md), opening one PR per page that
# genuinely qualified as a thin stub. Pages that don't need fertilizing are skipped with no
# branch or PR.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

PAGES_DIR="src/modules/ROOT/pages"
INDEX="$PAGES_DIR/index.adoc"

garden::check_clean
garden::sync_base

shopt -s nullglob
for file in "$PAGES_DIR"/*.adoc; do
  [[ "$file" == "$INDEX" ]] && continue
  name="$(basename "$file")"
  echo "=== Fertilizing: $file ==="
  garden::open_branch "fertilize-${name%.adoc}" >/dev/null

  pi -p --no-session \
    --model "$MODEL" \
    --thinking low \
    --tools read,edit,grep,find,ls \
    "Follow the fertilize skill's instructions in .agents/skills/fertilize/SKILL.md for
exactly one page: '$file'.
This is a non-interactive run: never ask for confirmation. Only expand '$file' if it genuinely
qualifies as a thin stub; otherwise make no changes. You may add one inbound xref: from a
related page if a natural fit surfaces, but do not otherwise edit any page besides '$file'.
Never change a maturity label in $INDEX. Do not run bash and do not commit."

  garden::commit_push_pr \
    "fertilize: expand ${name%.adoc}" \
    "Fertilize: ${name%.adoc}" \
    "Automated fertilize pass over \`$file\`, generated by pi. Review before merging." \
    "$file" \
    || continue
done
