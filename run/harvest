#!/usr/bin/env bash

#
# Run the `harvest` skill headlessly as a single pass, scoped and non-interactive (see
# .agents/skills/harvest/SKILL.md), appending a digest of recent activity to
# docs/digests.md and opening one PR for it. No-ops cleanly if there's nothing new to digest.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

garden::check_clean
garden::sync_base

echo "=== Harvesting the garden ==="
garden::open_branch "harvest" >/dev/null

pi -p --no-session \
  --model "$MODEL" \
  --thinking low \
  --tools read,edit,grep,find,ls \
  "Follow the harvest skill's instructions in .agents/skills/harvest/SKILL.md as a single
pass.
This is a non-interactive run: never ask for confirmation or for a window — default to since
the last saved digest in docs/digests.md, or the last 30 days if that file doesn't exist yet.
Pull the git log, classify each commit, and append a new dated section (newest first) to
docs/digests.md, creating the file if needed. Do not edit any other file. Do not run bash and
do not commit."

garden::commit_push_pr \
  "chore: append harvest digest" \
  "Harvest: activity digest" \
  "Automated harvest pass, generated by pi, appending a new digest to docs/digests.md. Review before merging." \
  "docs/digests.md"
