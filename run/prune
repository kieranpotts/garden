#!/usr/bin/env bash

#
# Walk every garden page and run the `prune` skill on it individually, scoped and
# non-interactive (see .agents/skills/prune/SKILL.md), opening one PR per page that had a
# genuine prune-worthy improvement. Pages with nothing to prune are skipped with no branch
# or PR.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

PAGES_DIR="src/modules/ROOT/pages"
INDEX="$PAGES_DIR/index.adoc"

garden::check_clean
garden::sync_base

shopt -s nullglob
for file in "$PAGES_DIR"/*.adoc; do
  [[ "$file" == "$INDEX" ]] && continue
  name="$(basename "$file")"
  echo "=== Pruning: $file ==="
  garden::open_branch "prune-${name%.adoc}" >/dev/null

  pi -p --no-session \
    --model "$MODEL" \
    --thinking low \
    --tools read,edit,grep,find,ls \
    "Follow the prune skill's instructions in .agents/skills/prune/SKILL.md for exactly one
page: '$file'.
This is a non-interactive run: never ask for confirmation. Make only small, self-evidently-
good edits to '$file' — cut waffle, smooth phrasing, drop local repetition, reorder within
the page. If nothing rises to a prune-worthy edit, make no changes. Report, don't act on,
anything bigger (graft/divide/tend/tidy/fertilize/uproot territory). Do not edit any other
page. Do not run bash and do not commit."

  garden::commit_push_pr \
    "prune: trim ${name%.adoc}" \
    "Prune: ${name%.adoc}" \
    "Automated prune pass over \`$file\`, generated by pi. Review before merging." \
    "$file"
done