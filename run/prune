#!/usr/bin/env bash

#
# Run the `prune` skill headlessly as a single whole-garden pass, scoped and non-interactive
# (see .agents/skills/prune/SKILL.md), opening one PR covering every near-certain duplicate
# merged in this pass. No-ops cleanly if nothing was merged.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

garden::check_clean
garden::sync_base

echo "=== Pruning the garden ==="
garden::open_branch "prune" >/dev/null

pi -p --no-session \
  --model "$MODEL" \
  --thinking low \
  --tools read,edit,grep,find,ls \
  "Follow the prune skill's instructions in .agents/skills/prune/SKILL.md as a single
whole-garden pass.
This is a non-interactive run: never ask for confirmation. Only merge pairs that are
near-certain duplicates. Repoint every xref: and index.adoc entry for each removed page
before deleting it. Report every candidate pair considered, including any left unmerged.
Do not run bash and do not commit."

garden::commit_push_pr \
  "prune: merge duplicate entries" \
  "Prune: garden-wide pass" \
  "Automated prune pass over the whole garden, generated by pi. Review before merging."
