#!/usr/bin/env bash

#
# Walk every garden page and run the `tidy` skill on it individually, scoped and
# non-interactive (see .agents/skills/tidy/SKILL.md), opening one PR per page that had a
# genuine tidy-worthy improvement. Pages with nothing to tidy are skipped with no branch or
# PR.
#

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
source ./lib.sh

PAGES_DIR="src/modules/ROOT/pages"
INDEX="$PAGES_DIR/index.adoc"

garden::check_clean
garden::sync_base

shopt -s nullglob
for file in "$PAGES_DIR"/*.adoc; do
  [[ "$file" == "$INDEX" ]] && continue
  name="$(basename "$file")"
  echo "=== Tidying: $file ==="
  garden::open_branch "tidy-${name%.adoc}" >/dev/null

  pi -p --no-session \
    --model "$MODEL" \
    --thinking low \
    --tools read,edit,grep,find,ls \
    "Follow the tidy skill's instructions in .agents/skills/tidy/SKILL.md for exactly one
page: '$file'.
This is a non-interactive run: never ask for confirmation. Make only small, self-evidently-
good edits to '$file' — trim waffle, smooth phrasing, drop local redundancy, reorder within
the page. If nothing rises to a tidy-worthy edit, make no changes. Report, don't act on,
anything bigger (graft/split/prune/tend/cultivate/fertilize territory). Do not edit any other
page. Do not run bash and do not commit."

  garden::commit_push_pr \
    "tidy: trim ${name%.adoc}" \
    "Tidy: ${name%.adoc}" \
    "Automated tidy pass over \`$file\`, generated by pi. Review before merging." \
    "$file"
done
